{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "bun"],
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["src", "scripts", "vite.config.ts", ".react-router/types/**/*", "workers", "worker-configuration.d.ts"]
}
