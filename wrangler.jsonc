{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-09-21",
  "main": "./workers/app.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "haydenhuan.com", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  // No id: wrangler creates the namespace on the first deploy.
  "kv_namespaces": [{ "binding": "CHAT_KV" }],
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
