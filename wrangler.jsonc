{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "personal-website",
	"compatibility_date": "2026-09-21",
	"main": "./workers/app.ts",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "haydenhuan.com",
			"custom_domain": true
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "personal-website-rag",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "CHAT_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}